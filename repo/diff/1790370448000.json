ze": 49509400}, "manifest": {"nativecode": ["armeabi-v7a"], "versionName": "2.1.0", "versionCode": 1232, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["c82244429913fc74cdcdb1b9f9c57b4af3353980d6edda4685971209dfe146e5"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.CHANGE_WIFI_STATE"}, {"name": "android.permission.CHANGE_NETWORK_STATE"}, {"name": "android.permission.NEARBY_WIFI_DEVICES"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "io.github.paxel.catlog.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "io.github.paxel.chaos_alert": {"metadata": {"added": 1790953422000, "categories": ["Time"], "changelog": "https://github.com/paxel/chaos-alert/blob/HEAD/CHANGELOG.md", "issueTracker": "https://github.com/paxel/chaos-alert/issues", "lastUpdated": 1790953423000, "license": "Apache-2.0 OR MIT", "sourceCode": "https://github.com/paxel/chaos-alert", "webSite": "https://github.com/paxel/chaos-alert", "featureGraphic": {"en-US": {"name": "/io.github.paxel.chaos_alert/en-US/featureGraphic_gO7cRUuVwAF8SG6xP850s8XK4QeTS0rUV0AWP_hSdoc=.png", "sha256": "80eedc454b95c0017c486eb13fce74b3c5cae107934b4ad45740163ff8527687", "size": 33525}}, "screenshots": {"phone": {"en-US": [{"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/01-home.png", "sha256": "151d15e414745d2f2426aa220ed2909e1571aa04661035b8224a51521d498662", "size": 92199}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/02-nag.png", "sha256": "27654c189772df034f86296cd0be85bfe68687a2d68c5cbd62d012caedad3411", "size": 45011}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/03-word.png", "sha256": "1733a1a4360b048d626c7e996e6d72d5b2fc7e3700878a8fa4f7616fe4e81ddf", "size": 52230}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/04-quiz.png", "sha256": "0b8c3f25cedd228ecd8459d73f323b6e5d171332b59292ed7041a216f0a2cb35", "size": 81270}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/05-failure.png", "sha256": "f182697a98bb0f00680b65a507f22317339cddae3670e4d175bcdfca3e423200", "size": 67640}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/06-alarms.png", "sha256": "e5b4280413865203b2fbf068dd7755f194fac8e56805bf04352c751ffc10cb70", "size": 90444}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/07-week.png", "sha256": "1141afe2e3cf1c051c9c77e9a435b3ef727aa9e990cbc1b6365b614b37b6caf1", "size": 76950}, {"name": "/io.github.paxel.chaos_alert/en-US/phoneScreenshots/08-month.png", "sha256": "33719970a88e51f87a9a45ce62f0155bc489009264d7dd2a4d53bdf66be2abd2", "size": 85338}]}}, "authorEmail": "taum@tuta.io", "authorName": "paxel", "name": {"en-US": "chaos-alert"}, "summary": {"en-US": "Bedtime nag, a word to remember, and an alarm that never sounds the same"}, "description": {"en-US": "Your alarm always sounds the same, so you sleep right through it. And \"just ten more minutes\" on the sofa turns into midnight again.\n\nchaos-alert nags you to bed when it's time, gives you one word to remember, and wakes you with a sound you never hear coming. To turn the alarm off, you pick last night's word from four. A wrong pick only snoozes it, and the app keeps count of how well you remembered.\n\n<b>What it does</b>\n<ul>\n<li><b>Bedtime nag</b> — at bedtime a quiet full-screen popup asks: Are you in bed? Bedtime follows from tomorrow's first alarm and how much sleep you want. Not yet? Snooze 10 minutes, or 30 min, 1 h, 2 h when you're out. Fell asleep without answering? The popup's time counts as your bedtime and nothing wakes you.</li>\n<li><b>In bed early</b> — the main screen offers \"I'm in bed\" in the three hours before bedtime.</li>\n<li><b>A word for the night</b> — one less common English word, shown once.</li>\n<li><b>The chaos alarm</b> — every ring picks something random: an alarm sound, a notification sound or a song from your music. Quiet at first, louder after 10 seconds, a new surprise after every snooze.</li>\n<li><b>The quiz</b> — four words, one of them last night's. Tap to mark, then OK. A wrong word snoozes the alarm and drops out of the next try; the page after the right one shows how many tries it took, your streak and your last 30 nights. Five misses in a row bring a gentle hint.</li>\n<li><b>I'm awake</b> — up before the alarm? In the hour before it, a button and a silent notification take you to the quiz; the right word turns off that morning's alarms.</li>\n<li><b>Alarms</b> — repeating on weekdays or once on a date; reminder alarms that shouldn't move your bedtime simply get their wake-up switch turned off.</li>\n<li><b>Vacations</b> — enter the dates once; repeating alarms and the nag stay quiet, one-time alarms still ring.</li>\n<li><b>Time in bed</b> — a week or a month of bars, coloured by how the quiz went, with your average time in bed and average bedtime.</li>\n</ul>\n\nEverything stays on your phone: no account, no internet permission, no tracking. Free and open source.\n"}, "donate": ["https://ko-fi.com/paxel7"], "icon": {"en-US": {"name": "/io.github.paxel.chaos_alert/en-US/icon_a3ykEtn6zk1sTFAC9BOI6Halo0w8Xnpoop7H1Yc8I3A=.png", "sha256": "6b7ca412d9face4d6c4c5002f41388e876a5a34c3c5e7a68a29ec7d5873c2370", "size": 18269}}, "preferredSigner": "f9c222c0b0d7412c58d3acb08661f20faee3bca2e789cf139de7ac3cc4f59cf8"}, "versions": {"f065767500231740a8851db8c7c450d2570bb0c93922e4f7f3b5d98b79c678b3": {"added": 1790953422000, "file": {"name": "/chaos-alert-0.2.0-android-arm64-v8a.apk", 